if SHIELD_ULP_SPLIT_LEFT

config ZMK_KEYBOARD_NAME
    default "ULP Split"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_ULP_SPLIT_LEFT || SHIELD_ULP_SPLIT_RIGHT

config ZMK_SPLIT
    default y

# trackpad on the right half, forwarded to the left (central) through zmk,input-split
config ZMK_POINTING
    default y

endif

if SHIELD_ULP_SPLIT_RIGHT

config I2C
    default y

endif
