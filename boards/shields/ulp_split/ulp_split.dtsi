/*
 * Matrix (see pcb/config.yaml), col2row: diodes point from column to row. 5 x 5 on D0..D9,
 * D10 and the NFC pads stay free for a trackpad.
 *   columns D0..D4 = outer, pinky, ring, middle, index
 *   rows    D7 top, D8 home, D9 bottom, D6 lower, D5 extra
 *   lower   outer 4 columns + near thumb (index column)
 *   extra   inner top/home/bottom (middle/index/ring column), mid thumb (pinky), far thumb (outer)
 * The right half lists its columns index..outer so columns 5..9 run left to right.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "ulp_split-layouts.dtsi"

&ulp_split_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &ulp_split_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <5>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(4,3)                                    RC(4,6) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(4,4)                                    RC(4,5) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(4,2)                                    RC(4,7) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(4,1) RC(4,0)    RC(4,9) RC(4,8) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&xiao_d 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };
};

/*
 * Trackpad on the right half (see ulp_split_right.overlay). The input split proxies it to the central,
 * whose listener (enabled in ulp_split_left.overlay) turns it into mouse reports. Defined here so the
 * keymap can reference &trackpad_listener (e.g. for input processors) on both halves.
 */
/ {
    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        trackpad_split: trackpad_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackpad_listener: trackpad_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&trackpad_split>;
    };
};
