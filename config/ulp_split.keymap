/*
 * Colemak + Swiss German umlauts, ported from the Sofle keymap (github.com/Ilosariph/Sofle-firmware).
 * No number row: numbers and F keys are on the NUM layer (lower pinky key on either half).
 *
 * Key order per layer: top, home, bottom row (12 keys each), then the bottom line:
 * left lower x4 (outer, pinky, ring, middle), left thumbs (near, mid, far),
 * right thumbs (far, mid, near), right lower x4 (middle, ring, pinky, outer).
 */

#include "keys_de_swiss.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define SYMBOLS 1
#define NUMPAD 2
#define FUNCTION 3
#define GAMING 4
#define GAMING_F 5
#define LAYER_SW 6
#define SETTINGS 7
#define NUM 8

/ {
    behaviors {
        mo_tog: mo_tog {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&tog>;
            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        home_row_shift: home_row_shift {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <130>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            // |  TAB  |  Q  |  W  |  F   |  P   |  G   |                                 |  J   |  L    |  U   |  Z   |  Ö   |  Ü    |
            // | CAPSW |  A  |  R  |  S   |  T   |  D   |                                 |  H   |  N    |  E   |  I   |  O   | Ä/LSW |
            // | CTRL  | Y/WIN| X/ALT| C   |  V   |  B   |                                 |  K   |  M    |  ,   | ./APP| -/RALT| RCTRL |
            // |  ESC  | NUM | ALT/↓|  ↑   | ENT/SHFT | BKSPC | FUNC |  | NUMPAD | SYM | SPC/SHFT |  ←   |  →   | NUM  |  DEL  |
            bindings = <
&kp TAB     &kp DE_Q                       &kp DE_W                       &kp DE_F      &kp DE_P  &kp DE_G                                                                                                      &kp DE_J  &kp DE_L  &kp DE_U                           &kp DE_Z                            &kp DE_O_UMLAUT  &kp DE_U_UMLAUT
&caps_word  &kp DE_A                       &kp DE_R                       &kp DE_S      &kp DE_T  &kp DE_D                                                                                                      &kp DE_H  &kp DE_N  &kp DE_E                           &kp DE_I                            &kp DE_O         &lt LAYER_SW DE_A_UMLAUT
&kp LCTRL   &home_row_shift LEFT_WIN DE_Y  &home_row_shift LEFT_ALT DE_X  &kp DE_C      &kp DE_V  &kp DE_B                                                                                                      &kp DE_K  &kp DE_M  &kp COMMA                          &home_row_shift K_APPLICATION DOT  &home_row_shift RIGHT_ALT DE_MINUS  &kp RCTRL
&kp ESC     &mo NUM                        &mt LEFT_ALT DOWN_ARROW        &kp UP_ARROW  &home_row_shift LEFT_SHIFT KP_ENTER  &kp BACKSPACE  &mo_tog FUNCTION FUNCTION    &mo_tog NUMPAD NUMPAD  &mo SYMBOLS  &home_row_shift RIGHT_SHIFT SPACE  &kp LEFT_ARROW  &kp RIGHT_ARROW  &mo NUM  &kp DEL
            >;
        };

        symbols {
            display-name = "Symbols";
            // |       |  !  |  @  |  (   |  )   |  '   |      |  \    |  ~    |   %   |       |       |
            // |       |  #  |  $  |  {   |  }   |  &   |      |  ¨    |  °    |   ^   |       | to 0  |
            // |       |  =  |  <  |  [   |  ]   |  ?   |      |  `    |  |    |   >   |       |       |
            //                          (? on the ENT/SHFT thumb)
            bindings = <
&trans  &kp DE_EXCL   &kp DE_AT    &kp DE_LPAR  &kp DE_RPAR  &kp DE_APOS                                &trans  &kp DE_BSLH    &kp DE_TILDE  &kp DE_PRCNT  &trans  &trans
&trans  &kp DE_HASH   &kp DE_DLLR  &kp DE_LBRC  &kp DE_RBRC  &kp DE_AMPS                                &trans  &kp DE_UMLAUT  &kp DE_DEG    &kp DE_CARET  &trans  &to BASE
&trans  &kp DE_EQUAL  &kp DE_LT    &kp DE_LBKT  &kp DE_RBKT  &kp DE_QMARK                               &trans  &kp DE_GRAVE   &kp DE_PIPE   &kp DE_GT     &trans  &trans
&trans  &trans        &trans       &trans       &kp DE_QUESTION  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        numpad {
            display-name = "Numpad";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                &trans  &kp N7  &kp N8  &kp N9  &kp PLUS   &kp STAR
&trans  &trans  &trans  &trans  &trans  &trans                                &trans  &kp N4  &kp N5  &kp N6  &kp MINUS  &to BASE
&trans  &trans  &trans  &trans  &trans  &trans                                &trans  &kp N1  &kp N2  &kp N3  &kp RET    &kp FSLH
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp N0  &kp N0  &kp N0  &kp DOT  &trans  &trans
            >;
        };

        function {
            display-name = "Function";
            // arrows as inverted T: ↑ on the bottom row of the middle column, ← ↓ → on ring lower, middle lower, near thumb
            bindings = <
&trans  &trans  &kp INSERT  &kp HOME  &kp PG_UP        &trans                                &trans  &kp INSERT       &kp HOME  &kp PG_UP  &trans  &trans
&trans  &trans  &kp DEL     &kp END   &kp PG_DN        &trans                                &trans  &kp DEL          &kp END   &kp PG_DN  &trans  &to BASE
&trans  &trans  &trans      &kp UP    &kp PRINTSCREEN  &trans                                &trans  &kp PRINTSCREEN  &kp UP    &trans     &trans  &trans
&trans  &trans  &kp LEFT    &kp DOWN  &kp RIGHT  &trans  &trans    &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
            >;
        };

        gaming {
            display-name = "Gaming";
            bindings = <
&kp TAB    &kp Q     &kp W  &kp E     &kp R  &kp T                                        &kp DE_Z  &kp U  &kp I      &kp O    &kp P            &kp DE_U_UMLAUT
&kp LSHFT  &kp A     &kp S  &kp D     &kp F  &kp G                                        &kp H     &kp J  &kp K      &kp L    &kp DE_O_UMLAUT  &kp DE_A_UMLAUT
&kp LCTRL  &kp DE_Y  &kp X  &kp C     &kp V  &kp B                                        &kp N     &kp M  &kp COMMA  &kp DOT  &trans           &trans
&kp ESC    &trans    &kp LALT  &mo GAMING_F  &kp SPACE  &kp BACKSPACE  &kp CAPSLOCK    &trans  &kp ENTER  &trans  &trans  &trans  &trans  &to BASE
            >;
        };

        gaming_f_keys {
            display-name = "Gaming F";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &trans
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp F11 &kp F12 &trans  &trans  &trans                                &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_switch {
            display-name = "Layer switch";
            // hold Ä, then: H settings, N gaming, E numpad, I function
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                &trans          &trans        &trans        &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                &to SETTINGS    &to GAMING    &to NUMPAD    &to FUNCTION    &trans  &to BASE
&trans  &trans  &trans  &trans  &trans  &trans                                &trans          &trans        &trans        &trans          &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        settings {
            display-name = "Settings";
            // BT_CLR forgets the current profile's host; bootloader = flash mode (same as double-tapping reset)
            bindings = <
&bt BT_CLR  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans       &trans
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                          &trans  &trans  &trans  &trans  &bootloader  &to BASE
&trans      &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans       &sys_reset
&bootloader &trans        &trans        &trans        &trans        &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        num {
            display-name = "Numbers";
            bindings = <
&trans  &kp N1   &kp N2   &kp N3  &kp N4  &kp N5                                &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &trans
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5                                &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &trans                                &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans   &trans   &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
