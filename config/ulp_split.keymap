/*
 * Colemak-DH-ish + Swiss German, ported from the tightarc Vial layout (OS layout: Swiss German).
 * No number row: hold two adjacent thumbs (NAV + Ent/Shift on the left or SYM + Spc/Shift on the right)
 * for the NUM layer (digits + F keys).
 *
 * Key order per layer: top, home, bottom row (12 keys each), then the bottom line:
 * left lower x4 (outer, pinky, ring, middle), left thumbs (near, mid, far),
 * right thumbs (far, mid, near), right lower x4 (middle, ring, pinky, outer).
 *
 * Positions: 0-11 top, 12-23 home, 24-35 bottom, 36-39 left lower, 40-42 left thumbs,
 * 43-45 right thumbs, 46-49 right lower.
 */

#include "keys_de_swiss.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define GAMING 1
#define NAV 2
#define SYM 3
#define FN 4
#define NUM 5

/ {
    behaviors {
        // thumb mod-taps (Ent/Shift, Spc/Shift, Del/Ctrl), mirrors the tightarc QMK settings:
        // tapping term 130, "Ignore Mod Tap Interrupt" off = Vial's get_hold_on_other_key_press()
        // returns true (hold-preferred: any other key pressed while held -> mod),
        // no tapping force hold (tap, then press+hold again within 130 ms = repeat the tap key),
        // no retro tapping (ZMK default)
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <130>;
            quick-tap-ms = <130>;
        };

        // A / Esc (tightarc tap dance: hold only after the 200 ms term)
        ht_slow: hold_tap_slow {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };
    };

    macros {
        bspc5: bspc5 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp BSPC &kp BSPC &kp BSPC &kp BSPC &kp BSPC>;
        };
    };

    combos {
        compatible = "zmk,combos";

        num_left {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <40 41>;
            bindings = <&mo NUM>;
            layers = <BASE>;
        };

        num_right {
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            key-positions = <43 44>;
            bindings = <&mo NUM>;
            layers = <BASE>;
        };

        // lock NAV: NAV thumb + right lower outer (Del); tap the NAV thumb to leave
        nav_lock {
            timeout-ms = <50>;
            key-positions = <40 49>;
            bindings = <&tog NAV>;
            layers = <BASE NAV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            // | TAB  |  Q    |  W   |  F   |  P   |  G   |                              |  J   |  L    |  U   |  Z   |  Ö   |  Ü      |
            // | GUI  | A/ESC |  R   |  S   |  T   |  D   |                              |  H   |  N    |  E   |  I   |  O   |  Ä      |
            // | CTRL |  Y    |  X   |  C   |  V   |  B   |                              |  K   |  M    |  ,   |  .   |  -   | APP/FN  |
            // | ESC  |  ALT  |  ↓   |  ↑   | NAV | ENT/SHFT | BKSPC |  | SYM | SPC/SHFT | DEL/CTRL |  ←   |  →   | RALT |  DEL  |
            bindings = <
&kp TAB    &kp DE_Q                &kp DE_W  &kp DE_F  &kp DE_P  &kp DE_G                                                                            &kp DE_J  &kp DE_L  &kp DE_U      &kp DE_Z  &kp DE_O_UMLAUT  &kp DE_U_UMLAUT
&kp LGUI   &ht_slow ESC DE_A       &kp DE_R  &kp DE_S  &kp DE_T  &kp DE_D                                                                            &kp DE_H  &kp DE_N  &kp DE_E      &kp DE_I  &kp DE_O         &kp DE_A_UMLAUT
&kp LCTRL  &kp DE_Y                &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B                                                                            &kp DE_K  &kp DE_M  &kp DE_COMMA  &kp DE_DOT  &kp DE_MINUS   &lt FN K_APP
&kp ESC    &kp LALT  &kp DOWN  &kp UP    &mo NAV  &ht LSHIFT RET  &kp BSPC    &mo SYM  &ht RSHIFT SPACE  &ht RCTRL DEL    &kp LEFT  &kp RIGHT  &kp RALT  &kp DEL
            >;
        };

        gaming {
            display-name = "Gaming";
            // plain QWERTY (toggle: Fn + N, leave: Fn + H or the Spc/Shift thumb); hold the lower
            // middle key (left) for numbers + F keys, the thumb combos are off here
            bindings = <
&kp TAB       &kp DE_Q  &kp DE_W  &kp DE_E  &kp DE_R  &kp DE_T                                &kp DE_Z  &kp DE_U  &kp DE_I      &kp DE_O    &kp DE_P         &kp DE_U_UMLAUT
&kp CAPSLOCK  &kp DE_A  &kp DE_S  &kp DE_D  &kp DE_F  &kp DE_G                                &kp DE_H  &kp DE_J  &kp DE_K      &kp DE_L    &kp DE_O_UMLAUT  &kp DE_A_UMLAUT
&kp LSHIFT    &kp DE_Y  &kp DE_X  &kp DE_C  &kp DE_V  &kp DE_B                                &kp DE_N  &kp DE_M  &kp DE_COMMA  &kp DE_DOT  &kp DE_MINUS     &kp RSHIFT
&kp LCTRL  &kp LALT  &kp LGUI  &mo NUM    &kp SPACE  &kp BSPC  &kp RET    &trans  &to BASE  &kp RET    &kp LEFT  &kp RIGHT  &kp RALT  &kp RCTRL
            >;
        };

        nav {
            display-name = "Nav";
            // inverted-T arrows on both halves (↑ on X / ., ← ↓ → on the lower row)
            bindings = <
&trans     &kp INSERT  &kp HOME  &kp PG_UP        &trans  &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp DEL     &kp END   &kp PG_DN        &trans  &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&kp LALT   &trans      &kp UP    &kp PRINTSCREEN  &trans  &trans                                &trans  &trans  &trans  &kp UP  &trans  &trans
&trans     &kp LEFT  &kp DOWN  &kp RIGHT    &trans  &trans  &trans    &trans  &trans  &trans    &kp LEFT  &kp DOWN  &kp RIGHT  &trans
            >;
        };

        symbols {
            display-name = "Symbols";
            // |   |  !  |  @  |  (  |  )  |  #  |      |   |  \  |  `  |  §  |     |   |
            // |   |  '  |  $  |  {  |  }  |  "  |      |   |  ¨  |  °  |  ^  |  ~  |   |
            // |   |  %  |  |  |  [  |  ]  |  &  |      |   |  /  |  ;  |  :  |  _  |   |
            // |   |  =  |  <  |  ?  |     |     | 5×BKSP |  |   |   |   |  `  |  >  |   |   |
            bindings = <
&trans  &kp DE_EXCL   &kp DE_AT    &kp DE_LPAR  &kp DE_RPAR  &kp DE_HASH                                &trans  &kp DE_BSLH    &kp DE_GRAVE      &kp DE_SECT   &trans        &trans
&trans  &kp DE_APOS   &kp DE_DLLR  &kp DE_LBRC  &kp DE_RBRC  &kp DE_DQT                                 &trans  &kp DE_UMLAUT  &kp LS(DE_SECT)   &kp DE_CARET  &kp DE_TILDE  &trans
&trans  &kp DE_PRCNT  &kp DE_PIPE  &kp DE_LBKT  &kp DE_RBKT  &kp DE_AMPS                                &trans  &kp KP_SLASH   &kp DE_SEMI       &kp DE_COLON  &kp DE_UNDER  &trans
&trans  &kp DE_EQUAL  &kp DE_LT    &kp DE_QMARK    &trans  &trans  &bspc5    &trans  &trans  &trans    &kp DE_GRAVE  &kp DE_GT  &trans  &trans
            >;
        };

        fn {
            display-name = "Fn";
            // right: media keys + H base / N gaming (from the tightarc); left: Bluetooth profiles, BT_CLR forgets the
            // current profile's host; bootloader = flash mode for the half it is pressed on
            bindings = <
&bt BT_CLR   &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &kp C_MUTE    &kp C_VOL_UP  &trans      &bootloader
&trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                          &to BASE  &tog GAMING  &kp C_PREV    &kp C_PP      &kp C_NEXT  &trans
&trans       &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans        &kp C_VOL_DN  &trans      &trans
&bootloader  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };

        num {
            display-name = "Numbers";
            bindings = <
&trans   &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                                &kp N6  &kp N7  &kp N8  &kp N9  &kp N0   &trans
&kp F11  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                                &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F12
&trans   &trans  &trans  &trans  &trans  &trans                                &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
